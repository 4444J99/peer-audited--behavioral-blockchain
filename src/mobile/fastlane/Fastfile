default_platform(:ios)

platform :ios do
  desc "Build iOS debug scheme"
  lane :build_debug do
    sh("cd ../.. && npx expo prebuild --platform ios --clean")
    build_app(
      workspace: "../ios/Styx.xcworkspace",
      scheme: "Styx",
      configuration: "Debug",
      export_method: "development",
      skip_codesigning: true,
      skip_archive: true,
      derived_data_path: "../ios/build"
    )
  end

  desc "Run iOS tests"
  lane :test do
    sh("cd ../.. && npm test")
  end

  desc "Build and upload to TestFlight (Beta)"
  lane :beta do
    if ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
        is_key_content_base64: true
      )
    end
    sh("cd ../.. && npx expo prebuild --platform ios")
    build_app(
      workspace: "../ios/Styx.xcworkspace",
      scheme: "Styx",
      configuration: "Release",
      export_method: "app-store",
      derived_data_path: "../ios/build"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Build Android debug APK"
  lane :build_debug do
    sh("cd ../.. && npx expo prebuild --platform android --clean")
    gradle(
      project_dir: "../android",
      task: "assembleDebug"
    )
  end

  desc "Run Android tests"
  lane :test do
    sh("cd ../.. && npm test")
  end
end
