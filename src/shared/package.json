{
  "name": "@styx/shared",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./index": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./libs/*": {
      "types": "./libs/*.ts",
      "default": "./dist/libs/*.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
