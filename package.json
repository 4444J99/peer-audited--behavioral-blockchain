{
  "name": "styx-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "src/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev/app-stack.mjs",
    "dev:api": "node scripts/dev/run-api.mjs",
    "dev:web": "node scripts/dev/run-web.mjs",
    "dev:migrate": "node scripts/dev/run-migrate.mjs",
    "dev:turbo": "turbo run dev",
    "test": "turbo run test",
    "load-test": "node scripts/load-test/run-load-tests.mjs",
    "demo:launch": "bash scripts/demo/launch.sh",
    "demo:reset": "bash scripts/demo/reset.sh",
    "demo:reset:verify": "bash scripts/demo/reset.sh verify",
    "demo:down": "bash scripts/demo/native.sh down",
    "demo:credentials": "bash scripts/demo/credentials.sh",
    "demo:verify": "bash scripts/demo/verify-live-stack.sh",
    "demo:share": "bash scripts/demo/share.sh",
    "snapshot:capture": "bash scripts/demo/snapshot.sh capture",
    "snapshot:build": "bash scripts/demo/snapshot.sh build",
    "snapshot:serve": "bash scripts/demo/snapshot.sh serve",
    "snapshot:verify": "bash scripts/demo/snapshot.sh verify",
    "snapshot:deploy": "bash scripts/demo/snapshot.sh deploy",
    "beta:verify": "node scripts/demo/verify-beta.mjs",
    "demo:feedback": "bash scripts/demo/feedback.sh start",
    "demo:feedback:stop": "bash scripts/demo/feedback.sh stop",
    "demo:feedback:status": "bash scripts/demo/feedback.sh status",
    "demo:feedback:report": "node scripts/demo/feedback-report.mjs",
    "demo:capture:tour": "node scripts/demo/capture-tour-fallback.mjs",
    "demo:capture:rehearsal": "bash scripts/demo/capture-signed-in-rehearsal.sh",
    "lint": "turbo run lint",
    "validate:claims": "node scripts/validation/07-claim-drift-check.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "npx playwright test --config=.config/playwright/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=.config/playwright/playwright.config.ts --ui",
    "test:e2e:headed": "npx playwright test --config=.config/playwright/playwright.config.ts --headed",
    "beta:readiness": "bash scripts/smoke/beta-readiness.sh",
    "beta:deploy-preflight": "bash scripts/smoke/beta-deploy-preflight.sh",
    "docs:ingest": "node scripts/analysis/ingest-doc-intelligence.js"
  },
  "devDependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@playwright/test": "1.62.0",
    "eslint": "^10.8.0",
    "jest-util": "^30.4.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "4.23.1",
    "turbo": "2.10.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.8",
    "ajv": ">=8.18.0",
    "minimatch": ">=10.2.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.26",
    "@nestjs/testing": "11.1.26",
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    },
    "serialize-javascript": ">=7.0.3",
    "multer": ">=2.1.0",
    "picomatch": "4.0.4",
    "ws": "8.20.1",
    "yaml": "2.8.3",
    "cross-spawn": "7.0.5",
    "postcss": "8.5.15"
  }
}
